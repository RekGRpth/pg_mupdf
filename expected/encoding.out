-- needs a UTF8 database (expected/encoding_1.out covers the others)
SELECT getdatabaseencoding() <> 'UTF8' AS skip_test \gset
\if :skip_test
\quit
\endif
CREATE EXTENSION IF NOT EXISTS pg_mupdf;
NOTICE:  extension "pg_mupdf" already exists, skipping
-- text is passed to MuPDF as UTF-8
SELECT convert_from(mupdf('<p>привет</p>', 'html', 'txt'), 'utf8');
 convert_from 
--------------
 привет      +
             +
 
(1 row)

-- bytea is passed as is: MuPDF honors http-equiv and the XML encoding declaration
SELECT convert_from(mupdf(convert_to('<meta http-equiv="Content-Type" content="text/html; charset=windows-1251"><p>привет</p>', 'win1251'), 'html', 'txt'), 'utf8');
 convert_from 
--------------
 привет      +
             +
 
(1 row)

SELECT convert_from(mupdf(convert_to('<?xml version="1.0" encoding="windows-1251"?><html xmlns="http://www.w3.org/1999/xhtml"><body><p>привет</p></body></html>', 'win1251'), 'xhtml', 'txt'), 'utf8');
 convert_from 
--------------
 привет      +
             +
 
(1 row)

