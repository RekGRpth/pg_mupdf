 inside pdf  +
             +
 
(1 row)

-- MuPDF messages come before the error
SELECT mupdf(convert_to('%PDF-1.7 garbage', 'utf8'), 'pdf');
WARNING:  syntax error: expected object number
WARNING:  format error: cannot find startxref
WARNING:  trying to repair broken xref
WARNING:  repairing PDF document
ERROR:  no objects found
-- a document without pages
SELECT length(mupdf(mupdf('<p>x</p>', 'html', 'pdf', '', ''), 'pdf', 'txt'));
WARNING:  document has no pages
 length 
--------
      0
(1 row)

-- invalid values
SET pg_mupdf.document_handlers = 'html,foo';
ERROR:  invalid value for parameter "pg_mupdf.document_handlers": "html,foo"
DETAIL:  Document handler "foo" is unknown or not available in this MuPDF build.
SET pg_mupdf.document_handlers = 'html,,pdf';
ERROR:  invalid value for parameter "pg_mupdf.document_handlers": "html,,pdf"
DETAIL:  List syntax is invalid.
SET pg_mupdf.document_handlers = '"HTML"';
ERROR:  invalid value for parameter "pg_mupdf.document_handlers": ""HTML""
DETAIL:  Document handler "HTML" is unknown or not available in this MuPDF build.
SET pg_mupdf.document_handlers = '';
SELECT mupdf('<p>x</p>');
ERROR:  No document handlers registered
-- unquoted names are case-insensitive
SET pg_mupdf.document_handlers = HTML, PDF;
SHOW pg_mupdf.document_handlers;
 pg_mupdf.document_handlers 
----------------------------
 html, pdf
(1 row)

SELECT convert_from(mupdf(pdf, 'pdf', 'txt'), 'utf8') FROM mupdf_doc;
 convert_from 
--------------
 inside pdf  +
             +
 
(1 row)

RESET pg_mupdf.document_handlers;
-- only superusers can change it
CREATE ROLE regress_mupdf_user;
GRANT SELECT ON mupdf_doc TO regress_mupdf_user;
SET ROLE regress_mupdf_user;
SET pg_mupdf.document_handlers = 'html,pdf';
ERROR:  permission denied to set parameter "pg_mupdf.document_handlers"
SELECT set_config('pg_mupdf.document_handlers', 'pdf', false);
ERROR:  permission denied to set parameter "pg_mupdf.document_handlers"
SELECT mupdf(pdf, 'pdf', 'txt') FROM mupdf_doc;
ERROR:  cannot find document handler for file type: 'pdf'
RESET ROLE;
DROP TABLE mupdf_doc;
DROP ROLE regress_mupdf_user;
